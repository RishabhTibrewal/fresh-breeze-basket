# Mobile Application Environment Configuration

# API Base URL:
# Leave commented out to auto-detect:
# - Android Emulator -> http://10.0.2.2:5000/api
# - iOS Simulator / Web -> http://localhost:5000/api
# - Physical device with Expo Go -> http://<your-local-ip>:5000/api
# Uncomment to override with a specific server:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Multi-tenant Subdomain identifier
EXPO_PUBLIC_TENANT_SUBDOMAIN=default

