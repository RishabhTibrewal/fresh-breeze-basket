{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["node"],
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "lib": ["dom", "es2017"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
