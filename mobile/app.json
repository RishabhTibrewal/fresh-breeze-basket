{
  "expo": {
    "name": "gofreshco",
    "slug": "rishabh",
    "scheme": "gofreshco",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gofreshco.app"
    },
    "android": {
      "package": "com.gofreshco.app",
      "versionCode": 3,
      "targetSdkVersion": 34,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.freshbreeze.basket",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "cf862d60-5ce8-46e8-a266-0d5f97e71b9b"
      }
    },
    "owner": "gulffreshs-team"
  }
}